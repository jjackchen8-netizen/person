{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "deepseek-chat",
    "api_key_env": "OPENAI_API_KEY",
    "base_url": "https://api.deepseek.com/v1",
    "throttle_sec": 0,
    "languages": ["zh"]
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 50
    },
    "rss": [
      {
        "name": "Hacker News Best",
        "url": "https://hnrss.org/best",
        "enabled": true
      },
      {
        "name": "TechCrunch",
        "url": "https://techcrunch.com/feed/",
        "enabled": true
      },
      {
        "name": "The Verge",
        "url": "https://www.theverge.com/rss/index.xml",
        "enabled": true
      },
      {
        "name": "36氪",
        "url": "https://36kr.com/feed",
        "enabled": true
      },
      {
        "name": "少数派",
        "url": "https://sspai.com/feed",
        "enabled": true
      },
      {
        "name": "InfoQ中文",
        "url": "https://www.infoq.cn/public/v1/article/getList?token=&id=33&size=30",
        "enabled": false
      },
      {
        "name": "机器之心",
        "url": "https://www.jiqizhixin.com/rss",
        "enabled": true
      }
    ]
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 24
  }
}
